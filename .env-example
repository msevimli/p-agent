# plife — environment configuration template
# ---------------------------------------------
# Copy this file to .env and fill in the values. .env is gitignored and holds
# secrets only — never commit it anywhere.
#
# File format: KEY=VALUE per line, '#' comments, optional surrounding quotes.
# Variables already exported in the shell/container environment win over .env.

# ---------------------------------------------------------------- API key(s)
# Required only for remote OpenAI-compatible endpoints (OpenRouter, etc.).
# Local llama.cpp servers need no key. One shared key is enough when all
# remote models use the same provider:
LLAMA_API_KEY=your_openrouter_api_key_here

# Per-model overrides. Keys entered through the Models dashboard are stored
# here as LLAMA_API_KEY_<MODEL_ID> (model id uppercased, non-alphanumerics
# become '_') — the model registry never stores keys itself:
# LLAMA_API_KEY_DEEPSEEK=your_key_here
# LLAMA_API_KEY_LING_3_0=your_key_here

# ---------------------------------------------------------------- optional
# HTTP port the dashboard listens on (default 8888):
# PORT=8888

# Directory the file/shell agent tools may operate in (default: the plife
# project directory):
# PLIFE_WORK_ROOT=/absolute/path/to/workspace

# Upstream diagnostic dump to /tmp/plife-dump.log (off by default):
# PLIFE_DEBUG_DUMP=1

# Tool-calling loop on/off and iteration cap (defaults: on, 10):
# TOOL_CALLING=true
# TOOL_MAX_ITERATIONS=10

# Path override for the .env file itself (tests, containers):
# PLIFE_DOTENV_FILE=/absolute/path/to/env/file