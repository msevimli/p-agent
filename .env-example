# plife — environment configuration template
# ---------------------------------------------
# Copy this file to .env and fill in the values. .env is gitignored and holds
# secrets only — never commit it anywhere.
#
# File format: KEY=VALUE per line, '#' comments, optional surrounding quotes.
# Variables already exported in the shell/container environment win over .env.

# ---------------------------------------------------------------- API key(s)
# Required only for remote OpenAI-compatible endpoints (OpenRouter, etc.).
# Local llama.cpp servers need no key. One shared key is enough when all
# remote models use the same provider:
LLAMA_API_KEY=your_openrouter_api_key_here

# Per-model overrides. Keys entered through the Models dashboard are stored
# here as LLAMA_API_KEY_<MODEL_ID> (model id uppercased, non-alphanumerics
# become '_') — the model registry never stores keys itself:
# LLAMA_API_KEY_DEEPSEEK=your_key_here
# LLAMA_API_KEY_LING_3_0=your_key_here

# ---------------------------------------------------------------- optional
# HTTP port the dashboard listens on (default 8888):
# PORT=8888

# llama.cpp server connection (the agent never starts or configures the
# server — it treats it as an external service). Point these at whichever
# model/server you run, no code changes needed:
# LLAMA_BASE_URL=http://127.0.0.1:8081
# LLAMA_MODEL=qwen2.5-coder-14b-instruct-q6_k.gguf

# No-data grace (ms) for a silent llama.cpp stream — must be long enough for
# a cold-start prefill on a slow CPU, INCLUDING the re-prefill after a
# history compaction (~6000 tokens at 7-15 tok/s = 7-14 min). Default
# 1200000 (20 min). While GET /slots is available the stream self-extends on
# liveness, so this is the backstop:
# LLAMA_STALL_TIMEOUT_MS=1200000

# Warm-up (one max_tokens=1 completion: system prompt + all 16 tools, so
# the prefix that real requests send is pre-filled in the llama.cpp KV cache
# before the first message). AUTO_WARMUP=false disables the startup warm-up.
# Runs on agent startup and via the Warm-up button in the model status panel.
# Timeout (ms) for that single call (default 1200000 = 20 min, like the stall
# timeout — a warm-up right after a compaction can re-prefill thousands of
# tokens on CPU):
# AUTO_WARMUP=true
# WARMUP_TIMEOUT_MS=1200000

# Strict serialization of LLM requests (1 = never two concurrent requests
# into a single-slot llama.cpp — title/summary/warm-up/chat all share the
# queue). Raise only for multi-slot servers:
# QUEUE_LIMIT=1

# Directory the file/shell agent tools may operate in (default: the plife
# project directory):
# PLIFE_WORK_ROOT=/absolute/path/to/workspace

# Timeout (ms) for a single model warm-up completion (POST /api/models/warmup).
# The warm-up shares the request queue with chat; this bounds the upstream
# llama.cpp HTTP call (default 1200000, 20 min):
# WARMUP_TIMEOUT_MS=1200000

# Upstream diagnostic dump to /tmp/plife-dump.log (off by default):
# PLIFE_DEBUG_DUMP=1

# Tool-calling loop on/off and iteration cap (defaults: on, 10):
# TOOL_CALLING=true
# TOOL_MAX_ITERATIONS=10

# Path override for the .env file itself (tests, containers):
# PLIFE_DOTENV_FILE=/absolute/path/to/env/file

# ------------------------------------------------------- context & history
# Context budget: budget = n_ctx − prefix − reserve − safety% of n_ctx.
# When the estimated history exceeds `high`% of the budget it is compacted
# once down to `low`% (deterministic; the last CONTEXT_KEEP_LAST_TURNS user
# turns and the system prompt are never touched). n_ctx is read from the
# server (/props, read-only); PROMPT_PREFIX_TOKENS is the static prefix
# estimate used until the server reports the real cached prefix. Defaults:
# CONTEXT_RESERVE_TOKENS=1024
# CONTEXT_SAFETY_PCT=5
# CONTEXT_COMPACT_HIGH_PCT=75
# CONTEXT_COMPACT_LOW_PCT=50
# CONTEXT_KEEP_LAST_TURNS=3
# PROMPT_PREFIX_TOKENS=2450
# CONTEXT_WINDOW_FALLBACK=16384
#
# Guard retry (no-tool fallback): when the model answers a live-data/action
# request with a shell block or a curl/wget command instead of a tool call,
# the agent retries ONCE with tool_choice:"required" (llama.cpp servers that
# accept the OpenAI-compat field). Set false for servers that reject it.
# GUARD_RETRY_TOOL_CHOICE=false

# Tool output limits: max characters of ONE serialized tool result stored in
# the conversation (applied once, at insertion; per-tool override via
# TOOL_OUTPUT_MAX_CHARS_<TOOL_NAME_UPPER>, e.g. TOOL_OUTPUT_MAX_CHARS_RUN_SHELL).
# read_file caps one call at READ_FILE_MAX_CHARS (use its offset/limit params
# to page); list_files lists at most LIST_FILES_MAX_ENTRIES entries:
# TOOL_OUTPUT_MAX_CHARS=4000
# READ_FILE_MAX_CHARS=6000
# LIST_FILES_MAX_ENTRIES=200

# Experimental: topic-based SUBSET of tools instead of the full set.
# Breaks the prompt cache when a tool group is added mid-conversation —
# keep off (default) on single-slot llama.cpp:
# LAZY_TOOLS=false

# ---------------------------------------------------------------- channels
# Telegram agent channel — managed from the dashboard (Tools → Channels);
# tokens are written here automatically. Admin chat id is always allowed to
# use the bot, even when the whitelist is empty:
# TELEGRAM_BOT_TOKEN=123456789:AAH-...your_bot_token
# TELEGRAM_ADMIN_CHAT_ID=123456789